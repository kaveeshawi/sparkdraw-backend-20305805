APP_NAME=Sparkdraw
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ── switch from sqlite to mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sparkdraw
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Sanctum ──
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# ── AI Provider (swap without code changes) ──
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── AI Microservice (internal) ──
AI_SERVICE_URL=http://localhost:8001

# ── Frontend origin (CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Mail ──
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sparkdraw.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── PayPal Sandbox (invoice REST API) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── Integration OAuth (one-click Connect) ──
# Leave empty to use demo one-click OAuth locally (INTEGRATIONS_DEMO_OAUTH=true).
INTEGRATIONS_DEMO_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
PAYPAL_OAUTH_CLIENT_ID=
PAYPAL_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
